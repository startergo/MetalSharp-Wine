diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index cffadf9..42591c8 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -4519,6 +4519,29 @@ NTSTATUS virtual_handle_fault( struct thread_data *data, EXCEPTION_RECORD *rec,
     }
 #endif
 
+    /* Win9x-era programs park the main thread's stack at the very top of the
+     * 4G space (the 9x loader's convention) and set Esp there without ever
+     * allocating it (AquaMark3's packed startup is one). Map the pages on
+     * demand, like a stack grow, and describe the region in the WoW TEB, or
+     * NtRaiseException refuses to dispatch its frames ("not in stack limits"). */
+    if (err == EXCEPTION_WRITE_FAULT && (ULONG_PTR)addr >= 0xffff0000UL &&
+        (ULONG_PTR)addr < 0x100000000UL && !vprot && is_wow64() &&
+        !map_fixed_area( (void *)0xffff0000UL, 0x10000, PROT_READ | PROT_WRITE ))
+    {
+        WOW_TEB *wow_teb = get_wow_teb( data->teb );
+        set_page_vprot( (void *)0xffff0000UL, 0x10000, VPROT_READ | VPROT_WRITE | VPROT_COMMITTED );
+        if (wow_teb && wow_teb->DeallocationStack < 0xffff0000UL)
+        {
+            wow_teb->DeallocationStack = 0xffff0000UL;
+            wow_teb->Tib.StackLimit = 0xfffff000UL;
+            wow_teb->Tib.StackBase = 0xfffffff8UL;
+        }
+        TRACE( "wow64 top-of-4G stack page %p mapped on demand\n", page );
+        mutex_unlock( &virtual_mutex );
+        rec->ExceptionCode = STATUS_SUCCESS;
+        return STATUS_SUCCESS;
+    }
+
     if (!is_inside_signal_stack( data, stack ) && (vprot & VPROT_GUARD))
     {
         struct thread_stack_info stack_info;
