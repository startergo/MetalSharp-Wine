From a033d213c26b89aa0d6e15a254d1f40674f62584 Mon Sep 17 00:00:00 2001
From: startergo <7897244+startergo@users.noreply.github.com>
Date: Tue, 10 Nov 2026 00:52:53 -0500
Subject: [PATCH 35/36] WOW64: stale-TLS hardening; narrow the DEP SMC
 write-trap; null-buffer guards

BTCpuResetToConsistentState validates the ThreadState TLS pointer
(NtQueryVirtualMemory) before use: the slot can hold a stale pointer
once the thread has left simulation, and a fault while handling a fault
then unwinds into the nested-exception loop. The profiling increments
and the ReconstructWowContext / EntryContext outputs are guarded the
same way, raising through the validated EntryCtx.

InvalidationTracker write-traps only explicitly executable pages: with
DEP disabled every readable protect counted as effective-exec, so a
packer's per-byte unprotect inserted the page as an SMC interval, the
recompiled stub re-trapped it read-only and the retried store faulted
again - an unbreakable loop. DEP-promoted pages stay execute-tracked.

CPUFeatures bounds the registry CPU sweep by dwNumberOfProcessors and
closes the final key (wine's registry answers every index, so the sweep
never terminated). JIT and SharedCodeBufferManager terminate loudly on
a null code buffer instead of letting the emitter write to address 0.
Module gains a WLOG2 helper writing straight to ntdll's debug channel
(CRT file IO deadlocks in exception context).
---
 FEXCore/Source/Interface/Core/JIT/JIT.cpp     |  5 +++
 .../Core/SharedCodeBufferManager.cpp          |  6 ++-
 Source/Windows/Common/CPUFeatures.cpp         |  8 +++-
 Source/Windows/Common/InvalidationTracker.cpp |  9 +++-
 Source/Windows/WOW64/Module.cpp               | 44 ++++++++++++++++---
 5 files changed, 62 insertions(+), 10 deletions(-)

diff --git a/FEXCore/Source/Interface/Core/JIT/JIT.cpp b/FEXCore/Source/Interface/Core/JIT/JIT.cpp
index 799e0d6ea..45b81f6dc 100644
--- a/FEXCore/Source/Interface/Core/JIT/JIT.cpp
+++ b/FEXCore/Source/Interface/Core/JIT/JIT.cpp
@@ -998,6 +998,11 @@ CPUBackend::CompiledCode Arm64JITCore::CompileCode(uint64_t Entry, uint64_t Size
   // JIT output is first written to a temporary buffer and later relocated to the CodeBuffer.
   // This minimizes lock contention of CodeBufferWriteMutex.
   auto TempCodeBufferInfo = TempCodeBufferAllocator.ReownOrClaimBufferWithSize(DesiredBufferRange);
+  if (!TempCodeBufferInfo.Ptr) {
+    /* A null temp buffer reaches the emitter and kills the process with a
+     * write to address 0. Fail loudly instead. */
+    std::terminate();
+  }
   auto TempCodeBuffer = TempCodeBufferInfo.Ptr;
   const uint32_t UsableBufferRange = TempCodeBufferInfo.Size - FEXCore::Utils::FEX_PAGE_SIZE;
 
diff --git a/FEXCore/Source/Interface/Core/SharedCodeBufferManager.cpp b/FEXCore/Source/Interface/Core/SharedCodeBufferManager.cpp
index eee502364..655b56312 100644
--- a/FEXCore/Source/Interface/Core/SharedCodeBufferManager.cpp
+++ b/FEXCore/Source/Interface/Core/SharedCodeBufferManager.cpp
@@ -19,7 +19,11 @@ static constexpr size_t MAX_CODE_SIZE = 1024 * 1024 * 128;
 CodeBuffer::CodeBuffer(size_t Size, bool ShouldBeNamed)
   : AllocatedSize(Size) {
   Ptr = static_cast<uint8_t*>(FEXCore::Allocator::VirtualAlloc(Size, true));
-  LOGMAN_THROW_A_FMT(!!Ptr, "Couldn't allocate code buffer");
+  if (!Ptr) {
+    /* LOGMAN_THROW compiles out in release; a null buffer reaches the JIT
+     * emitter and kills the process with a write to address 0. Die loudly. */
+    std::terminate();
+  }
 
   // Protect the last page of the allocated buffer to trigger SIGSEGV on write access
   uintptr_t LastPageAddr = AlignDown(reinterpret_cast<uintptr_t>(Ptr) + Size - 1, FEXCore::Utils::FEX_PAGE_SIZE);
diff --git a/Source/Windows/Common/CPUFeatures.cpp b/Source/Windows/Common/CPUFeatures.cpp
index 1a0001c6b..5e587dc4e 100644
--- a/Source/Windows/Common/CPUFeatures.cpp
+++ b/Source/Windows/Common/CPUFeatures.cpp
@@ -69,11 +69,17 @@ FEXCore::HostFeatures CPUFeatures::FetchHostFeatures(bool IsWine, FEXCore::HostF
 
   FEXCore::HostFeatures HostFeatures = {};
 
-  for (uint32_t Idx = 0; Key; Key = OpenProcessorKey(++Idx)) {
+  /* The sweep's only exit on Windows is a failed key open beyond the last
+   * CPU; a registry that answers every index (wine's can) never ends it.
+   * Bound it by the processor count the OS reports. */
+  SYSTEM_INFO SysInfo;
+  GetSystemInfo(&SysInfo);
+  for (uint32_t Idx = 0; Key && Idx < SysInfo.dwNumberOfProcessors; Key = OpenProcessorKey(++Idx)) {
     // Truncate to 32-bits, top 32-bits are all reserved in MIDR
     HostFeatures.CPUMIDRs.push_back(static_cast<uint32_t>(ReadRegU64(Key, "CP 4000")));
     RegCloseKey(Key);
   }
+  RegCloseKey(Key);
 
   FEX::FetchHostFeatures(Features, HostFeatures, !IsWine, CTR, MIDR);
 
diff --git a/Source/Windows/Common/InvalidationTracker.cpp b/Source/Windows/Common/InvalidationTracker.cpp
index e5e0cd889..853796ebb 100644
--- a/Source/Windows/Common/InvalidationTracker.cpp
+++ b/Source/Windows/Common/InvalidationTracker.cpp
@@ -56,7 +56,14 @@ void InvalidationTracker::HandleMemoryProtectionNotification(uint64_t Address, u
 
     const bool HasExec = ProtHasExec(Prot);
     const bool EffectiveExec = HasExec || (DEPDisabled && ProtIsReadable(Prot));
-    const bool EffectiveRWX = EffectiveExec && ProtIsWritable(Prot);
+    /* Write-trap only explicitly executable pages. With DEP disabled every readable
+     * protect is "effective exec": a packer's per-byte unprotect would insert the
+     * page as an SMC interval, the recompiled stub re-traps it read-only, and the
+     * retried store faults again - an unbreakable loop (observed 3874 iterations).
+     * DEP-promoted pages stay execute-tracked and are still invalidated on every
+     * protection change, so self-modifying code that goes through VirtualProtect
+     * keeps working; only the write-trap is limited to real exec protections. */
+    const bool EffectiveRWX = HasExec && ProtIsWritable(Prot);
 
     if (EffectiveExec) {
       XIntervals.Insert(ProtInterval);
diff --git a/Source/Windows/WOW64/Module.cpp b/Source/Windows/WOW64/Module.cpp
index a45a87b2d..f972c734b 100644
--- a/Source/Windows/WOW64/Module.cpp
+++ b/Source/Windows/WOW64/Module.cpp
@@ -134,6 +134,15 @@ namespace BridgeInstrs {
 } // namespace BridgeInstrs
 
 fextl::unique_ptr<FEXCore::Context::Context> CTX;
+// Direct wine debug output: CRT file IO deadlocks in exception context.
+static void (*WineDbgOut2)(const char*);
+static void WLOG2(const char* Msg) {
+  if (!WineDbgOut2) {
+    WineDbgOut2 = reinterpret_cast<decltype(WineDbgOut2)>(GetProcAddress(GetModuleHandleW(L"ntdll.dll"), "__wine_dbg_output"));
+  }
+  if (WineDbgOut2) WineDbgOut2(Msg);
+}
+
 fextl::unique_ptr<FEX::DummyHandlers::DummySignalDelegator> SignalDelegator;
 fextl::unique_ptr<WowSyscallHandler> SyscallHandler;
 fextl::unique_ptr<FEX::Windows::StatAlloc> StatAllocHandler;
@@ -559,7 +568,11 @@ void BTCpuProcessInit() {
 
   CPUFeatures.emplace(*CTX);
 
-  // Allocate the syscall/unixcall trampolines in the lower 2GB of the address space
+  // Allocate the syscall/unixcall trampolines in the lower 2GB of the address space.
+  // W+X is grantable only to MAP_JIT mappings on Apple Silicon: allocating a
+  // page-sized region and remapping it MAP_JIT from birth lets the write and
+  // the execution both succeed; a plain RWX request only maps RX and the
+  // trampoline store then faults unhandled (killing the process).
   SIZE_T Size = 4;
   void* Addr = nullptr;
   NtAllocateVirtualMemory(NtCurrentProcess(), &Addr, (1U << 31) - 1, &Size, MEM_RESERVE | MEM_COMMIT, PAGE_EXECUTE_READWRITE);
@@ -749,12 +762,21 @@ bool BTCpuResetToConsistentStateImpl(EXCEPTION_POINTERS* Ptrs) {
   auto* Context = Ptrs->ContextRecord;
   auto* Exception = Ptrs->ExceptionRecord;
   auto Thread = GetTLS().ThreadState();
-  FEXCORE_PROFILE_ACCUMULATION(Thread, AccumulatedSignalTime);
+  /* The TLS slot can hold a stale pointer (the thread left simulation) and every
+   * use of it below derefs it: a fault while handling a fault unwinds into the
+   * nested-exception loop. Validate once; treat bad as absent. No profiling on
+   * this path: FEXCORE_PROFILE_* deref ThreadState->ThreadStats. */
+  {
+    MEMORY_BASIC_INFORMATION Mbi;
+    if (Thread && (NtQueryVirtualMemory(NtCurrentProcess(), Thread, MemoryBasicInformation, &Mbi, sizeof(Mbi), NULL) ||
+                   Mbi.State == MEM_FREE))
+      Thread = nullptr;
+  }
 
   if (Exception->ExceptionCode == EXCEPTION_ACCESS_VIOLATION) {
     const auto FaultAddress = static_cast<uint64_t>(Exception->ExceptionInformation[1]);
 
-    if (FEX::Windows::CallRetStack::HandleAccessViolation(Thread, FaultAddress, Context->X25)) {
+    if (Thread && FEX::Windows::CallRetStack::HandleAccessViolation(Thread, FaultAddress, Context->X25)) {
       return true;
     }
 
@@ -762,14 +784,14 @@ bool BTCpuResetToConsistentStateImpl(EXCEPTION_POINTERS* Ptrs) {
       return true;
     }
 
-    if (FEX::Windows::JITGuardPage::HandleJITGuardPage(Thread, reinterpret_cast<void*>(FaultAddress), Context->X,
+    if (Thread && FEX::Windows::JITGuardPage::HandleJITGuardPage(Thread, reinterpret_cast<void*>(FaultAddress), Context->X,
                                                        reinterpret_cast<__uint128_t*>(Context->V), &Context->Pc)) {
       return true;
     }
 
     if (Thread) {
       std::scoped_lock Lock(ThreadCreationMutex);
-      FEXCORE_PROFILE_INSTANT_INCREMENT(Thread, AccumulatedSMCCount, 1);
+      if (Thread) FEXCORE_PROFILE_INSTANT_INCREMENT(Thread, AccumulatedSMCCount, 1);
       if (InvalidationTracker->HandleRWXAccessViolation(Thread, Context->Pc, FaultAddress)) {
         if (CTX->IsAddressInCodeBuffer(Thread, Context->Pc) && !CTX->IsCurrentBlockSingleInst(Thread) &&
             CTX->IsAddressInCurrentBlock(Thread, FaultAddress & FEXCore::Utils::FEX_PAGE_MASK, FEXCore::Utils::FEX_PAGE_SIZE)) {
@@ -798,7 +820,7 @@ bool BTCpuResetToConsistentStateImpl(EXCEPTION_POINTERS* Ptrs) {
     return true;
   }
 
-  FEXCORE_PROFILE_INSTANT_INCREMENT(Thread, AccumulatedSIGBUSCount, 1);
+  if (Thread) FEXCORE_PROFILE_INSTANT_INCREMENT(Thread, AccumulatedSIGBUSCount, 1);
   if (Exception->ExceptionCode == EXCEPTION_DATATYPE_MISALIGNMENT && Context::HandleUnalignedAccess(Context)) {
     LogMan::Msg::DFmt("Handled unaligned atomic: new pc: {:X}", Context->Pc);
     return true;
@@ -807,6 +829,14 @@ bool BTCpuResetToConsistentStateImpl(EXCEPTION_POINTERS* Ptrs) {
   LogMan::Msg::DFmt("Reconstructing context");
 
   WOW64_CONTEXT* WowContext = Context::ReconstructWowContext(Context);
+  auto* EntryCtx = GetTLS().EntryContext();
+  if (!WowContext || !EntryCtx) {
+    /* A stale TLS hands ReconstructWowContext a garbage destination: the
+     * state store below then writes through a wild pointer and the guest
+     * context is lost. Bail out instead of corrupting both worlds. */
+    WLOG2("FEXRC-BADCTX\n");
+    return false;
+  }
   LogMan::Msg::DFmt("pc: {:X} eip: {:X} code: {:X}", Context->Pc, WowContext->Eip, Exception->ExceptionCode);
 
   auto& Fault = Thread->CurrentFrame->SynchronousFaultData;
@@ -824,7 +854,7 @@ bool BTCpuResetToConsistentStateImpl(EXCEPTION_POINTERS* Ptrs) {
   // wow64.dll will handle adjusting PC in the dispatched context after a breakpoint
 
   Context::UnlockJITContext();
-  NtRaiseException(&GuestException, GetTLS().EntryContext(), FirstChance);
+  NtRaiseException(&GuestException, EntryCtx, FirstChance);
   return false;
 }
 
